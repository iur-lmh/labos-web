# =============================================================================
# labos-web — copiar a .env.local
# =============================================================================

# URL pública de la API (visible en el navegador si se usa directamente)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL interna para SSR y Route Handlers (Docker: http://api:8000)
LABOS_API_INTERNAL_URL=http://localhost:8000

# Branding
NEXT_PUBLIC_APP_NAME=LabOS LMH

# URL pública del sitio (sitemap / metadatos); opcional en desarrollo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
